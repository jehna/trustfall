{
  "name": "trustfall",
  "private": true,
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.md\"",
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "prettier --check \"**/*.md\" && npm run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ]
  }
}
